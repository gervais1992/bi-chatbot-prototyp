# ---------------------------------------------------------------------------
# Konfiguration. Kopieren nach `.env` und Werte eintragen:
#     cp .env.example .env
# Die Datei `.env` ist per .gitignore ausgeschlossen und wird beim Start
# automatisch von app.py geladen. Der Demo-Modus braucht nichts davon.
# ---------------------------------------------------------------------------

# --- Cloud-API-Modus (nur eines von beiden noetig) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Beispiel-Modellname -- an aktuell verfuegbare Modelle anpassen.
BI_MODEL=claude-sonnet-5

# --- Lokaler Modus (Ollama) -- kein Schluessel noetig ---
OLLAMA_BASE_URL=http://localhost:11434/v1
# Leichtgewichtige Empfehlungen: llama3.2:3b (~2 GB), granite4:3b, qwen3:8b
OLLAMA_MODEL=llama3.2:3b
